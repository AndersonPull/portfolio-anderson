@inject NavigationManager Navigation

<div class="home-root @(menuOpen ? "menu-open" : null)">
    <header class="home-topbar">
        <button type="button"
                class="home-burger"
                aria-label="@(menuOpen ? "Fechar menu" : "Abrir menu")"
                aria-expanded="@menuOpen"
                @onclick="ToggleMenu">
            <span></span>
            <span></span>
        </button>
    </header>

    <nav class="home-nav" aria-label="Principal">
        <a class="home-nav-link"
           href="https://marketplace.visualstudio.com/items?itemName=AndersonOliveira.zoiodelula"
           target="_blank"
           rel="noopener noreferrer"
           @onclick="CloseMenu">Produtos</a>
        <a class="home-nav-link" href="newsletter" @onclick="GoNewsletter" @onclick:preventDefault>Newsletter</a>
        <a class="home-nav-loja"
           href="https://marketplace.visualstudio.com/items?itemName=AndersonOliveira.zoiodelula"
           target="_blank"
           rel="noopener noreferrer"
           @onclick="CloseMenu">
            Loja
            <img src="Images/arrow_green_right.png" class="home-nav-loja-arrow" alt="" />
        </a>
    </nav>

    @* Desktop (Drrobo layout) *@
    <div class="home-desktop">
        <div class="row justify-content-between home-row">
            <div class="col-md-4 align-self-center home-left">
                <h1 class="home-title">Anderson.</h1>
                <h2 class="tag-number footer">000</h2>
            </div>
            <div class="col-md-7 m-0 align-self-center home-right">
                <div class="footer-container">
                    <div class="row justify-content-between home-copy-row">
                        <div class="col-md-6 align-self-center">
                            <p class="text1">
                                Software engineer focado em .NET<br>
                                com mobile, backend<br>
                                e frontend
                            </p>
                        </div>
                        <div class="col-md-6 align-self-center">
                            <div class="text2">
                                <p>
                                    Anderson<br>
                                    software for product
                                </p>
                            </div>
                        </div>
                    </div>
                    <img src="Images/modelo.png" alt="Anderson" class="footer-image" />
                    <div class="terminal @(moverTerminal ? "move-right" : null)">
                        <p class="terminal_text">&gt;_ Estamos em construção</p>
                        <button type="button"
                                class="terminal_button"
                                @onclick="OnTerminalClick"
                                aria-label="Ir para Newsletter">
                            <img src="Images/arrow_green_right.png" class="terminal_button_image" alt="" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Mobile (lab. mockup composition) *@
    <div class="home-mobile">
        <h1 class="home-mobile-title">Anderson.</h1>

        <div class="home-mobile-stage">
            <p class="home-mobile-rail">
                Anderson<br />
                software for product
            </p>

            <img class="home-mobile-photo" src="Images/modelo.png" alt="Anderson" />

            <div class="home-mobile-panel @(moverTerminal ? "move-right" : null)">
                <p class="home-mobile-panel-text">&gt;_ Estamos em construção</p>
                <button type="button"
                        class="home-mobile-cta"
                        @onclick="OnTerminalClick"
                        aria-label="Ir para Newsletter">
                    <img src="Images/arrow_green_right.png" alt="" />
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool moverTerminal;
    private bool menuOpen;

    private void ToggleMenu() => menuOpen = !menuOpen;

    private void CloseMenu() => menuOpen = false;

    private void GoNewsletter()
    {
        CloseMenu();
        Navigation.NavigateTo("newsletter");
    }

    private async Task OnTerminalClick()
    {
        moverTerminal = true;
        StateHasChanged();
        await Task.Delay(700);
        Navigation.NavigateTo("newsletter");
    }
}
