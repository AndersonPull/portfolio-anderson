@using System.Threading
@inject NavigationManager Navigation
@inject HttpClient Http
@implements IAsyncDisposable

<div class="home-root">
    @* SiteNav vem do MainLayout *@

    @* Desktop (Drrobo layout) *@
    <div class="home-desktop">
        <div class="row justify-content-between home-row">
            <div class="col-md-4 align-self-center home-left">
                <h1 class="home-title">Anderson.</h1>
                <h2 class="tag-number footer">000</h2>
            </div>
            <div class="col-md-7 m-0 align-self-center home-right">
                <div class="footer-container">
                    <div class="row justify-content-between home-copy-row">
                        <div class="col-md-6 align-self-center">
                            <p class="text1">
                                Software engineer focado em .NET<br>
                                com mobile, backend<br>
                                e frontend
                            </p>
                        </div>
                        <div class="col-md-6 align-self-center">
                            <div class="text2">
                                <p>
                                    Anderson<br>
                                    software for product
                                </p>
                            </div>
                        </div>
                    </div>
                    <img src="Images/modelo.png" alt="Anderson" class="footer-image" />
                    <div class="terminal @(moverTerminal ? "move-right" : null)">
                        @TerminalLog
                        <button type="button"
                                class="terminal_button"
                                @onclick="OnTerminalClick"
                                aria-label="Ir para Newsletter">
                            <img src="Images/arrow_green_right.png" class="terminal_button_image" alt="" />
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Mobile (lab. mockup composition) *@
    <div class="home-mobile">
        <h1 class="home-mobile-title">Anderson.</h1>

        <div class="home-mobile-stage">
            <p class="home-mobile-rail">
                Anderson<br />
                software for product
            </p>

            <img class="home-mobile-photo" src="Images/modelo.png" alt="Anderson" />

            <div class="home-mobile-panel @(moverTerminal ? "move-right" : null)">
                @TerminalLog
                <button type="button"
                        class="home-mobile-cta"
                        @onclick="OnTerminalClick"
                        aria-label="Ir para Newsletter">
                    <img src="Images/arrow_green_right.png" alt="" />
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private bool moverTerminal;
    private readonly List<string> _sourceLines = [];
    private readonly List<string> _completedLines = [];
    private string _currentTyped = string.Empty;
    private bool _showCaret = true;
    private CancellationTokenSource? _typingCts;

    private RenderFragment TerminalLog => __builder =>
    {
        <div class="terminal-log">
            @foreach (var line in _completedLines)
            {
                <p class="terminal-line">@line</p>
            }
            @if (_showCaret || !string.IsNullOrEmpty(_currentTyped))
            {
                <p class="terminal-line terminal-line-active">@_currentTyped<span class="terminal-caret">|</span></p>
            }
        </div>
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTerminalLinesAsync();
        _typingCts = new CancellationTokenSource();
        _ = RunTypewriterAsync(_typingCts.Token);
    }

    private async Task LoadTerminalLinesAsync()
    {
        try
        {
            var cacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            var data = await Http.GetFromJsonAsync<TerminalFeed>($"home/terminal.json?v={cacheBust}");
            if (data?.Lines is { Count: > 0 })
            {
                _sourceLines.AddRange(data.Lines.Where(l => !string.IsNullOrWhiteSpace(l)));
                return;
            }
        }
        catch
        {
            // fallback below
        }

        _sourceLines.Add(">_ Estamos em construção");
    }

    private async Task RunTypewriterAsync(CancellationToken ct)
    {
        try
        {
            foreach (var line in _sourceLines)
            {
                ct.ThrowIfCancellationRequested();
                _currentTyped = string.Empty;
                _showCaret = true;
                await InvokeAsync(StateHasChanged);

                foreach (var ch in line)
                {
                    ct.ThrowIfCancellationRequested();
                    _currentTyped += ch;
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(38, ct);
                }

                _completedLines.Add(line);
                _currentTyped = string.Empty;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(420, ct);
            }

            // Keep caret blinking on a trailing empty prompt line.
            _currentTyped = ">_ ";
            _showCaret = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // disposed
        }
    }

    private async Task OnTerminalClick()
    {
        moverTerminal = true;
        StateHasChanged();
        await Task.Delay(700);
        Navigation.NavigateTo("newsletter");
    }

    public async ValueTask DisposeAsync()
    {
        if (_typingCts is null)
            return;

        await _typingCts.CancelAsync();
        _typingCts.Dispose();
        _typingCts = null;
    }

    private sealed class TerminalFeed
    {
        public List<string> Lines { get; set; } = [];
    }
}
