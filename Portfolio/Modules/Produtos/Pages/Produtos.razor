@page "/produtos"
@using System.Threading
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="produtos-page @(_docking ? "is-docking" : null) @(_docked ? "is-docked" : null) @(_opened ? "is-opened" : null)">
    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="produtos-error">@_error</p>
    }

    <canvas @ref="_canvas" class="produtos-canvas @(_ready ? "is-ready" : null)"></canvas>

    <h1 class="produtos-wordmark">NFC.</h1>

    <aside class="produtos-rail" aria-label="Detalhes">
        <p class="produtos-rail-index">— 01</p>
        <div class="produtos-rail-block">
            <p class="produtos-rail-kicker">Produto</p>
            <p>Cartucho digital.<br>Software feito para<br>abrir e construir.</p>
        </div>
        <div class="produtos-rail-block">
            <p class="produtos-rail-kicker">Stack</p>
            <p>.NET, Visual Studio<br>e ferramenta no fluxo<br>do dia a dia.</p>
        </div>
    </aside>

    <div class="produtos-modal" role="dialog" aria-label="Terminal">
        <div class="produtos-modal-window">
            <div class="produtos-modal-chrome" aria-hidden="true">
                <span class="produtos-modal-title">terminal</span>
                <div class="produtos-modal-controls">
                    <span class="produtos-modal-btn">─</span>
                    <span class="produtos-modal-btn">□</span>
                    <span class="produtos-modal-btn is-close">✕</span>
                </div>
            </div>
            <div class="produtos-modal-body">
                @foreach (var line in _completedLines)
                {
                    <p class="produtos-modal-line">@line</p>
                }
                <p class="produtos-modal-line">
                    @_activeLine<span class="produtos-modal-caret">&nbsp;</span>
                </p>
            </div>
        </div>
    </div>

    <button type="button"
            class="produtos-scroll"
            disabled="@(!_ready || _dockBusy || _opened)"
            @onclick="OnDockClick"
            aria-label="@(_docked ? "Abrir produto" : "Aproximar cartucho do celular")">
        <img src="Images/arrow_green_right.png" class="produtos-scroll-arrow" alt="" />
    </button>
</div>

@code {
    private static readonly string[] SpinFrames = new[] { "|", "/", "-", "\\" };
    private static readonly string[] AfterLoadLines =
    {
        ">_ Zoio de Lula",
        ">_ Extensão para Visual Studio",
        ">_ Cartucho digital",
        ">_ software for product"
    };
    private static readonly string[] AfterDockLines =
    {
        ">_ Aproximando cartucho",
        ">_ NFC detectado",
        ">_ Lendo tag... ok",
        ">_ Abrindo produto"
    };
    private static readonly string[] AfterOpenLines =
    {
        ">_ Encaixando controle",
        ">_ MobileController ok",
        ">_ Dual grip + analog",
        ">_ Pronto para jogar"
    };

    private ElementReference _canvas;
    private bool _ready;
    private string _error;
    private bool _mounted;
    private bool _docking;
    private bool _docked;
    private bool _opened;
    private bool _dockBusy;
    private readonly List<string> _completedLines = new();
    private string _activeLine = ">_ ";
    private CancellationTokenSource _lifeCts;
    private CancellationTokenSource _typeCts;

    protected override void OnInitialized()
    {
        _lifeCts = new CancellationTokenSource();
        ResetTypeCts();
        _ = RunTerminalAsync(_typeCts.Token);
    }

    private void ResetTypeCts()
    {
        try { _typeCts?.Cancel(); } catch { }
        _typeCts?.Dispose();
        _typeCts = CancellationTokenSource.CreateLinkedTokenSource(_lifeCts.Token);
    }

    private async Task OnDockClick()
    {
        if (_dockBusy || _opened || !_ready)
            return;

        if (_docked)
        {
            ResetTypeCts();
            _dockBusy = true;
            _opened = true;
            _docking = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(280);

            try
            {
                await JS.InvokeVoidAsync("produtoModel.playOpen");
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex);
            }

            _completedLines.Clear();
            _activeLine = ">_ ";
            _docking = false;
            _dockBusy = false;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(420);
            await RunOpenTerminalAsync(_typeCts.Token);
            return;
        }

        ResetTypeCts();
        _dockBusy = true;
        _docking = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(420);

        try
        {
            await JS.InvokeVoidAsync("produtoModel.playDock");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }

        _completedLines.Clear();
        _activeLine = ">_ ";
        _docked = true;
        _docking = false;
        _dockBusy = false;
        await InvokeAsync(StateHasChanged);
        await RunDockTerminalAsync(_typeCts.Token);
    }

    private async Task RunTerminalAsync(CancellationToken ct)
    {
        try
        {
            await TypeLineAsync(">_ Carregando...", ct);
            var i = 0;
            while (!ct.IsCancellationRequested && !_ready && string.IsNullOrEmpty(_error))
            {
                if (_docking || _docked)
                    return;
                _activeLine = ">_ Carregando... " + SpinFrames[i];
                i = (i + 1) % SpinFrames.Length;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(90, ct);
            }

            if (_docking || _docked)
                return;

            _completedLines.Add(">_ Carregando... ok");
            _activeLine = ">_ ";
            await InvokeAsync(StateHasChanged);
            await Task.Delay(280, ct);

            foreach (var line in AfterLoadLines)
            {
                if (_docking || _docked)
                    return;
                await TypeLineAsync(line, ct);
                _completedLines.Add(line);
                _activeLine = ">_ ";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(320, ct);
            }

            _activeLine = ">_ ";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // leaving
        }
    }

    private async Task RunDockTerminalAsync(CancellationToken ct)
    {
        try
        {
            foreach (var line in AfterDockLines)
            {
                ct.ThrowIfCancellationRequested();
                await TypeLineAsync(line, ct);
                _completedLines.Add(line);
                _activeLine = ">_ ";
                StateHasChanged();
                await Task.Delay(320, ct);
            }

            _activeLine = ">_ ";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // leaving
        }
    }

    private async Task RunOpenTerminalAsync(CancellationToken ct)
    {
        try
        {
            foreach (var line in AfterOpenLines)
            {
                ct.ThrowIfCancellationRequested();
                await TypeLineAsync(line, ct);
                _completedLines.Add(line);
                _activeLine = ">_ ";
                StateHasChanged();
                await Task.Delay(320, ct);
            }

            _activeLine = ">_ ";
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // leaving
        }
    }

    private async Task TypeLineAsync(string text, CancellationToken ct)
    {
        _activeLine = string.Empty;
        StateHasChanged();
        await Task.Delay(16, ct);
        foreach (var ch in text)
        {
            ct.ThrowIfCancellationRequested();
            _activeLine += ch;
            StateHasChanged();
            await Task.Delay(38, ct);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _mounted)
            return;

        _mounted = true;
        try
        {
            await JS.InvokeVoidAsync("produtoModel.mount", _canvas, "3dModels/Cartucho.glb");
            _ready = true;
        }
        catch (Exception ex)
        {
            _error = "Não foi possível carregar o modelo 3D.";
            Console.WriteLine(ex);
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { _typeCts?.Cancel(); } catch { }
        _typeCts?.Dispose();
        _typeCts = null;

        if (_lifeCts != null)
        {
            await _lifeCts.CancelAsync();
            _lifeCts.Dispose();
            _lifeCts = null;
        }

        try { await JS.InvokeVoidAsync("produtoModel.dispose"); } catch { }
    }
}
