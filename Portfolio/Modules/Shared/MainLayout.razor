@inherits LayoutComponentBase
@implements IDisposable

@inject NavigationManager NavigationManager

<div class="page @(IsHome ? "layout-home" : "layout-sitenav")">
    <SiteNav />

    <div class="main">
        <div class="content @(IsHome ? "content-home" : "px-4")">
            @Body
        </div>
    </div>
</div>

@code {
    private bool IsHome { get; set; }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        SyncRouteState();
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        SyncRouteState();
        InvokeAsync(StateHasChanged);
    }

    private void SyncRouteState()
    {
        var path = new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');
        IsHome = string.IsNullOrEmpty(path);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
