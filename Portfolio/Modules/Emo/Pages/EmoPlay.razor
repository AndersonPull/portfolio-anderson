@page "/emo/play/{GameId}"
@layout EmoLayout
@using Portfolio.Modules.Emo.Models
@using Portfolio.Modules.Emo.Components
@implements IAsyncDisposable

@inject IGameCatalogService GameCatalogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div id="emo-play-root" class="emo-play">
    <div class="emo-top-right">
        @if (_emulatorInitialized && Game is not null)
        {
            <EmoSettingsMenu GameId="@Game.Id" Core="@Game.Core" />
        }
        <button type="button"
                class="emo-fullscreen-btn"
                onclick="emoEmulator.enterFullscreen('emo-play-root')"
                aria-label="Jogar em tela cheia"
                title="Tela cheia">
            <i class="bi bi-arrows-fullscreen"></i>
        </button>
    </div>

    @if (IsLoadingGame)
    {
        <div class="emo-play-status">
            <p>Carregando...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="emo-play-status">
            <p>@ErrorMessage</p>
        </div>
    }
    else if (Game is not null)
    {
        <div class="emo-screen">
            <div class="emo-stage">
                <canvas id="emo-canvas" class="emo-canvas"></canvas>
            </div>
            @if (_gamepadConnected)
            {
                <div class="emo-gamepad-badge" aria-live="polite" title="Controle conectado" aria-label="Controle conectado">
                    <i class="bi bi-controller"></i>
                </div>
            }
            else
            {
                <div class="emo-controls">
                    <VirtualGamepad System="@Game.System" Buttons="@Game.Buttons" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string GameId { get; set; } = string.Empty;

    private GameEntry? Game { get; set; }
    private bool IsLoadingGame = true;
    private bool _emulatorInitialized;
    private bool _gamepadConnected;
    private bool _gamepadWatchStarted;
    private string? ErrorMessage;
    private DotNetObjectReference<EmoPlay>? _dotNetRef;

    protected override async Task OnParametersSetAsync()
    {
        if (_emulatorInitialized)
            await JSRuntime.InvokeVoidAsync("emoEmulator.stop");

        await StopGamepadWatchAsync();

        IsLoadingGame = true;
        ErrorMessage = null;
        _emulatorInitialized = false;
        _gamepadConnected = false;
        _gamepadWatchStarted = false;

        Game = await GameCatalogService.GetGameByIdAsync(GameId);
        if (Game is null)
            ErrorMessage = "Jogo não encontrado.";

        IsLoadingGame = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_emulatorInitialized || Game is null || !string.IsNullOrEmpty(ErrorMessage))
            return;

        try
        {
            var romUrl = new Uri(new Uri(NavigationManager.BaseUri), Game.Rom).ToString();
            await JSRuntime.InvokeVoidAsync("emoEmulator.lockZoom");
            await JSRuntime.InvokeAsync<bool>("emoEmulator.init", "emo-canvas", romUrl, Game.Core);
            _emulatorInitialized = true;

            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("emoEmulator.startGamepadWatch", _dotNetRef);
            _gamepadWatchStarted = true;

            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erro ao iniciar o emulador: {ex.Message}";
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnGamepadChanged(bool connected)
    {
        if (_gamepadConnected == connected)
            return;

        _gamepadConnected = connected;
        InvokeAsync(StateHasChanged);
    }

    private async Task StopGamepadWatchAsync()
    {
        if (!_gamepadWatchStarted)
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("emoEmulator.stopGamepadWatch");
        }
        catch
        {
            // Ignore when tearing down.
        }

        _gamepadWatchStarted = false;
    }

    public async ValueTask DisposeAsync()
    {
        await StopGamepadWatchAsync();

        try
        {
            await JSRuntime.InvokeVoidAsync("emoEmulator.unlockZoom");
            await JSRuntime.InvokeVoidAsync("emoEmulator.stop");
        }
        catch
        {
            // Ignore dispose races.
        }

        _dotNetRef?.Dispose();
        _dotNetRef = null;
    }
}
