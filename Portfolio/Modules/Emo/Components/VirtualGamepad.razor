@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="virtual-gamepad"
     @oncontextmenu:preventDefault="true"
     @onpointerdown:preventDefault="true"
     @onpointerup:preventDefault="true">
    <div class="gamepad-stick @(IsStickActive ? "active" : "")"
         @ref="_stickBase"
         @onpointerdown="OnStickDown"
         @onpointermove="OnStickMove"
         @onpointerup="OnStickUp"
         @onpointercancel="OnStickUp">
        <div class="stick-ring"></div>
        <div class="stick-knob" style="@KnobStyle"></div>
    </div>

    @if (TopRow.Count > 0 || BottomRow.Count > 0)
    {
        <div class="gamepad-actions">
            @if (TopRow.Count > 0)
            {
                <div class="action-row">
                    @foreach (var button in TopRow)
                    {
                        <button type="button"
                                class="gamepad-btn action-btn action-@button.Label.ToLowerInvariant() @(IsPressed(button.Code) ? "pressed" : "")"
                                @onpointerdown="@(() => PressKey(button.Code))"
                                @onpointerup="@(() => ReleaseKey(button.Code))"
                                @onpointerleave="@(() => ReleaseKey(button.Code))"
                                @onpointercancel="@(() => ReleaseKey(button.Code))">@button.Label</button>
                    }
                </div>
            }
            @if (BottomRow.Count > 0)
            {
                <div class="action-row">
                    @foreach (var button in BottomRow)
                    {
                        <button type="button"
                                class="gamepad-btn action-btn action-@button.Label.ToLowerInvariant() @(IsPressed(button.Code) ? "pressed" : "")"
                                @onpointerdown="@(() => PressKey(button.Code))"
                                @onpointerup="@(() => ReleaseKey(button.Code))"
                                @onpointerleave="@(() => ReleaseKey(button.Code))"
                                @onpointercancel="@(() => ReleaseKey(button.Code))">@button.Label</button>
                    }
                </div>
            }
        </div>
    }

    @if (ShowSelect || ShowStart)
    {
        <div class="system-buttons">
            @if (ShowSelect)
            {
                <button type="button"
                        class="gamepad-btn system-btn select-btn @(IsPressed("select") ? "pressed" : "")"
                        @onpointerdown="@(() => PressKey("select"))"
                        @onpointerup="@(() => ReleaseKey("select"))"
                        @onpointerleave="@(() => ReleaseKey("select"))"
                        @onpointercancel="@(() => ReleaseKey("select"))">
                    SELECT
                </button>
            }
            @if (ShowStart)
            {
                <button type="button"
                        class="gamepad-btn system-btn start-btn @(IsPressed("start") ? "pressed" : "")"
                        @onpointerdown="@(() => PressKey("start"))"
                        @onpointerup="@(() => ReleaseKey("start"))"
                        @onpointerleave="@(() => ReleaseKey("start"))"
                        @onpointercancel="@(() => ReleaseKey("start"))">
                    START
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string System { get; set; } = "snes";

    [Parameter]
    public IEnumerable<string> Buttons { get; set; }

    private readonly HashSet<string> _pressedKeys = [];
    private readonly HashSet<string> _stickDirs = [];
    private GamepadLayout _layout = SnesLayout;
    private ElementReference _stickBase;
    private double _knobX;
    private double _knobY;
    private double _stickCenterX;
    private double _stickCenterY;
    private double _stickMaxRadius;
    private long? _activePointerId;
    private bool _disposed;

    private IReadOnlyList<FaceButton> TopRow => _layout.Top;
    private IReadOnlyList<FaceButton> BottomRow => _layout.Bottom;
    private bool ShowSelect => _layout.Select;
    private bool ShowStart => _layout.Start;
    private bool IsStickActive => _activePointerId.HasValue || _stickDirs.Count > 0;

    private string KnobStyle =>
        FormattableString.Invariant($"transform: translate(calc(-50% + {_knobX:0.##}px), calc(-50% + {_knobY:0.##}px));");

    protected override void OnParametersSet()
    {
        _layout = BuildLayout(System, Buttons);
    }

    private bool IsPressed(string code) => _pressedKeys.Contains(code);

    private async Task PressKey(string code)
    {
        if (_pressedKeys.Add(code))
        {
            await JSRuntime.InvokeVoidAsync("emoEmulator.simulateKey", code, true);
            StateHasChanged();
        }
    }

    private async Task ReleaseKey(string code)
    {
        if (_pressedKeys.Remove(code))
        {
            await JSRuntime.InvokeVoidAsync("emoEmulator.simulateKey", code, false);
            StateHasChanged();
        }
    }

    private async Task OnStickDown(PointerEventArgs e)
    {
        if (_activePointerId.HasValue)
            return;

        var rect = await JSRuntime.InvokeAsync<DomRect>("emoEmulator.getRect", _stickBase);
        if (rect.Width <= 0 || rect.Height <= 0)
            return;

        _stickCenterX = rect.Left + rect.Width / 2;
        _stickCenterY = rect.Top + rect.Height / 2;
        _stickMaxRadius = Math.Min(rect.Width, rect.Height) * 0.34;
        _activePointerId = e.PointerId;

        await JSRuntime.InvokeVoidAsync("emoEmulator.capturePointer", _stickBase, e.PointerId);
        await UpdateStick(e.ClientX, e.ClientY);
    }

    private async Task OnStickMove(PointerEventArgs e)
    {
        if (_activePointerId != e.PointerId)
            return;

        await UpdateStick(e.ClientX, e.ClientY);
    }

    private async Task OnStickUp(PointerEventArgs e)
    {
        if (_activePointerId != e.PointerId)
            return;

        await JSRuntime.InvokeVoidAsync("emoEmulator.releasePointer", _stickBase, e.PointerId);
        _activePointerId = null;
        _knobX = 0;
        _knobY = 0;
        await SyncStickDirs([]);
        StateHasChanged();
    }

    private async Task UpdateStick(double clientX, double clientY)
    {
        if (_stickMaxRadius <= 0)
            return;

        var maxRadius = _stickMaxRadius;
        var dx = clientX - _stickCenterX;
        var dy = clientY - _stickCenterY;
        var magnitude = Math.Sqrt(dx * dx + dy * dy);

        if (magnitude > maxRadius && magnitude > 0)
        {
            dx = dx / magnitude * maxRadius;
            dy = dy / magnitude * maxRadius;
            magnitude = maxRadius;
        }

        _knobX = dx;
        _knobY = dy;

        var wanted = new HashSet<string>(StringComparer.Ordinal);
        var deadzone = maxRadius * 0.22;
        var axisThreshold = maxRadius * 0.32;

        if (magnitude >= deadzone)
        {
            if (dx >= axisThreshold) wanted.Add("right");
            if (dx <= -axisThreshold) wanted.Add("left");
            if (dy >= axisThreshold) wanted.Add("down");
            if (dy <= -axisThreshold) wanted.Add("up");

            if (wanted.Count == 0)
            {
                if (Math.Abs(dx) >= Math.Abs(dy))
                    wanted.Add(dx > 0 ? "right" : "left");
                else
                    wanted.Add(dy > 0 ? "down" : "up");
            }
        }

        await SyncStickDirs(wanted);
        StateHasChanged();
    }

    private async Task SyncStickDirs(HashSet<string> wanted)
    {
        foreach (var dir in _stickDirs.ToArray())
        {
            if (!wanted.Contains(dir))
            {
                _stickDirs.Remove(dir);
                await JSRuntime.InvokeVoidAsync("emoEmulator.simulateKey", dir, false);
            }
        }

        foreach (var dir in wanted)
        {
            if (_stickDirs.Add(dir))
                await JSRuntime.InvokeVoidAsync("emoEmulator.simulateKey", dir, true);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
            return;

        _disposed = true;
        _activePointerId = null;
        _knobX = 0;
        _knobY = 0;

        foreach (var dir in _stickDirs.ToArray())
        {
            _stickDirs.Remove(dir);
            try
            {
                await JSRuntime.InvokeVoidAsync("emoEmulator.simulateKey", dir, false);
            }
            catch (JSDisconnectedException)
            {
                // page unloading
            }
        }
    }

    private static GamepadLayout BuildLayout(string system, IEnumerable<string> buttons)
    {
        var baseLayout = ResolveSystemLayout(system);
        var allowed = buttons?
            .Where(b => !string.IsNullOrWhiteSpace(b))
            .Select(b => b.Trim().ToLowerInvariant())
            .ToHashSet();

        if (allowed is null || allowed.Count == 0)
            return baseLayout;

        var top = baseLayout.Top.Where(b => allowed.Contains(b.Label.ToLowerInvariant())).ToList();
        var bottom = baseLayout.Bottom.Where(b => allowed.Contains(b.Label.ToLowerInvariant())).ToList();
        var select = baseLayout.Select && allowed.Contains("select");
        var start = baseLayout.Start && allowed.Contains("start");

        return new GamepadLayout(top, bottom, select, start);
    }

    private static GamepadLayout ResolveSystemLayout(string system)
        => system?.Trim().ToLowerInvariant() switch
        {
            "nes" or "famicom" => NesLayout,
            "genesis" or "megadrive" or "sega" => GenesisLayout,
            "gba" => GbaLayout,
            "gb" or "gbc" => GameBoyLayout,
            _ => SnesLayout
        };

    private static readonly GamepadLayout SnesLayout = new(
        Top: [new("y", "Y"), new("x", "X"), new("r", "R")],
        Bottom: [new("a", "A"), new("b", "B"), new("l", "L")],
        Select: true,
        Start: true);

    private static readonly GamepadLayout GenesisLayout = new(
        Top: [new("y", "Y"), new("x", "X"), new("r", "Z")],
        Bottom: [new("a", "A"), new("b", "B"), new("l", "C")],
        Select: false,
        Start: true);

    private static readonly GamepadLayout NesLayout = new(
        Top: [],
        Bottom: [new("b", "B"), new("a", "A")],
        Select: true,
        Start: true);

    private static readonly GamepadLayout GbaLayout = new(
        Top: [new("l", "L"), new("r", "R")],
        Bottom: [new("b", "B"), new("a", "A")],
        Select: true,
        Start: true);

    private static readonly GamepadLayout GameBoyLayout = new(
        Top: [],
        Bottom: [new("b", "B"), new("a", "A")],
        Select: true,
        Start: true);

    private sealed record FaceButton(string Code, string Label);

    private sealed record GamepadLayout(
        IReadOnlyList<FaceButton> Top,
        IReadOnlyList<FaceButton> Bottom,
        bool Select,
        bool Start);

    private sealed class DomRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }
}
